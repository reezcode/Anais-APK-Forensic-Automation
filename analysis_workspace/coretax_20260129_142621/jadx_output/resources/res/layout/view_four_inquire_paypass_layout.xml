<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:background="0x7f05014d"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="0x7f0600a0"
            android:textStyle="bold"
            android:textColor="0x7f05005a"
            android:layout_gravity="center_horizontal"
            android:id="0x7f08031e"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="0x7f060093"
            android:text="0x7f110168"
            android:layout_centerHorizontal="true"/>
        <LinearLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:background="0x7f070191"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="15dp"
            android:weightSum="4">
            <TextView
                android:textSize="0x7f0603a6"
                android:textColor="0x7f05002c"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="0x7f08033d"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:inputType="numberPassword"/>
            <View
                android:background="0x7f05014b"
                android:layout_width="0x7f0600eb"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="0x7f0603a6"
                android:textColor="0x7f05002c"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="0x7f08033e"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:inputType="numberPassword"/>
            <View
                android:background="0x7f05014b"
                android:layout_width="0x7f0600eb"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="0x7f0603a6"
                android:textColor="0x7f05002c"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="0x7f08033f"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:inputType="numberPassword"/>
            <View
                android:background="0x7f05014b"
                android:layout_width="0x7f0600eb"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="0x7f0603a6"
                android:textColor="0x7f05002c"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="0x7f080340"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginBottom="5dp"
                android:layout_weight="1"
                android:inputType="numberPassword"/>
        </LinearLayout>
        <RelativeLayout
            android:background="0x7f05014c"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <GridView
                android:id="0x7f080149"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0x7f0600eb"
                android:listSelector="0x7f05014c"
                android:horizontalSpacing="0x7f0600eb"
                android:verticalSpacing="0x7f0600eb"
                android:numColumns="3"/>
        </RelativeLayout>
    </LinearLayout>
</RelativeLayout>
