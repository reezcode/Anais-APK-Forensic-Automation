<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="?android:attr/dialogTheme"
    android:id="0x7f080289"
    android:padding="24dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textStyle="bold"
        android:id="0x7f08028b"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Report a Bug"
        android:layout_alignRight="0x7f08028a"
        android:layout_alignParentTop="true"
        style="?android:attr/windowTitleStyle"/>
    <ImageView
        android:id="0x7f08028a"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="0x7f0701a1"
        android:tint="?android:attr/colorForeground"
        android:layout_alignTop="0x7f08028b"
        android:layout_alignBottom="0x7f08028b"
        android:layout_alignParentRight="true"
        android:contentDescription="Logo of the brand"/>
    <TextView
        android:textStyle="bold"
        android:id="0x7f08028e"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Name"
        android:layout_below="0x7f08028b"/>
    <EditText
        android:id="0x7f080288"
        android:background="0x7f0701a0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Your Name"
        android:layout_below="0x7f08028e"
        android:inputType="textPersonName"
        android:paddingHorizontal="8dp"/>
    <TextView
        android:textStyle="bold"
        android:id="0x7f08028d"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Email"
        android:layout_below="0x7f080288"/>
    <EditText
        android:id="0x7f080287"
        android:background="0x7f0701a0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="your.email@example.org"
        android:layout_below="0x7f08028d"
        android:inputType="textEmailAddress"
        android:paddingHorizontal="8dp"/>
    <TextView
        android:textStyle="bold"
        android:id="0x7f08028c"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Description (Required)"
        android:layout_below="0x7f080287"/>
    <EditText
        android:gravity="top|left"
        android:id="0x7f080286"
        android:background="0x7f0701a0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="What&apos;s the bug? What did you expect?"
        android:lines="6"
        android:layout_below="0x7f08028c"
        android:inputType="textMultiLine"
        android:paddingHorizontal="8dp"/>
    <Button
        android:textColor="?android:attr/textColorPrimaryInverse"
        android:id="0x7f080285"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Send Bug Report"
        android:layout_below="0x7f080286"
        android:backgroundTint="?android:attr/colorPrimary"/>
    <Button
        android:id="0x7f080284"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Cancel"
        android:layout_below="0x7f080285"
        android:backgroundTint="?android:attr/colorBackground"/>
</RelativeLayout>
