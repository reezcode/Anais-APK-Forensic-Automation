<?xml version="1.0" encoding="utf-8"?>
<org.olctg.mediacodec.widget.localmedia.views.SquareRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="0x7f080283"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="0x7f070137"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:gravity="right"
        android:orientation="vertical"
        android:id="0x7f080281"
        android:padding="8dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentRight="true">
        <TextView
            android:textSize="12sp"
            android:textColor="0x7f050413"
            android:gravity="center"
            android:id="0x7f080280"
            android:background="0x7f070130"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="0x7f050413"
        android:gravity="center_vertical"
        android:id="0x7f080282"
        android:background="0x7f0e0000"
        android:paddingLeft="5dp"
        android:paddingTop="8dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="00:00"
        android:drawableLeft="0x7f0e000e"
        android:drawablePadding="15dp"
        android:layout_alignParentBottom="true"/>
