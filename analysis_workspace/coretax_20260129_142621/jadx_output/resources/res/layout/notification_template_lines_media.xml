<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingRight="8dp"
    android:paddingBottom="2dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:paddingEnd="8dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="0x7f0801a4"
        android:paddingTop="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0x7f060386"
        android:layout_marginStart="0x7f060386">
        <TextView
            android:textAppearance="0x7f1201e3"
            android:ellipsize="marquee"
            android:id="0x7f0802ee"
            android:fadingEdge="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
        <DateTimeView
            android:textAppearance="0x7f1201e1"
            android:layout_gravity="center"
            android:id="0x7f0802eb"
            android:paddingLeft="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="0"
            android:paddingStart="8dp"/>
        <Chronometer
            android:textAppearance="0x7f1201e1"
            android:layout_gravity="center"
            android:id="0x7f0800b2"
            android:paddingLeft="8dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="0"
            android:paddingStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textAppearance="0x7f1201de"
        android:ellipsize="marquee"
        android:id="0x7f0802da"
        android:visibility="gone"
        android:fadingEdge="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0x7f060386"
        android:layout_marginTop="-2dp"
        android:layout_marginBottom="-2dp"
        android:singleLine="true"
        android:layout_marginStart="0x7f060386"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="0x7f0801a5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="0x7f060386"
        android:layout_marginStart="0x7f060386">
        <TextView
            android:textAppearance="0x7f1201df"
            android:ellipsize="marquee"
            android:layout_gravity="center"
            android:id="0x7f0802d9"
            android:fadingEdge="horizontal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"/>
        <TextView
            android:textAppearance="0x7f1201dc"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="0x7f080170"
            android:paddingLeft="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="0"
            android:paddingStart="8dp"/>
    </LinearLayout>
</LinearLayout>
