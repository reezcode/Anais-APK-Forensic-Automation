<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="0x7f0700a9"
        android:paddingTop="15dp"
        android:paddingBottom="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginRight="10dp">
        <TextView
            android:textSize="14sp"
            android:textColor="0x7f050083"
            android:ellipsize="marquee"
            android:id="0x7f080336"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:text="醉千年.mp3"
            android:singleLine="true"
            android:marqueeRepeatLimit="marquee_forever"/>
        <RelativeLayout
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="5dp"
            android:layout_marginTop="15dp"
            android:layout_marginRight="5dp">
            <TextView
                android:textSize="12sp"
                android:textColor="0x7f050083"
                android:id="0x7f080337"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:layout_centerVertical="true"/>
            <SeekBar
                android:id="0x7f0801fd"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:maxHeight="4dp"
                android:max="100"
                android:progressDrawable="0x7f0700aa"
                android:minHeight="4dp"
                android:thumb="0x7f0700a2"
                android:thumbOffset="0dp"
                android:layout_weight="1"
                android:layout_toRightOf="0x7f080337"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="0x7f050083"
                android:id="0x7f080338"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:layout_toRightOf="0x7f0801fd"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <TextView
                android:textSize="14sp"
                android:textColor="0x7f050413"
                android:gravity="center"
                android:id="0x7f080343"
                android:background="0x7f0700a8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="25dp"
                android:text="0x7f110086"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="0x7f050413"
                android:gravity="center"
                android:id="0x7f080349"
                android:background="0x7f0700a8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="0x7f110087"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14sp"
                android:textColor="0x7f050413"
                android:gravity="center"
                android:id="0x7f080346"
                android:background="0x7f0700a8"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:layout_marginRight="25dp"
                android:text="0x7f110335"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
