<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.olctg.mediacodec.recorder.glsurface.MediaCodecRecordGlSurfaceView
        android:id="0x7f08009d"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="0x7f08009c"
        android:background="#33000000"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true">
        <ImageView
            android:id="0x7f08009b"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginLeft="15dp"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="0x7f08009e"
            android:visibility="visible"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="0x7f0e0014"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="0x7f08009f"
            android:padding="3dp"
            android:visibility="gone"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="0x7f0e0016"
            android:scaleType="fitXY"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="0x7f080254"
        android:background="#33000000"
        android:layout_width="match_parent"
        android:layout_height="35dp">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="5dp"
            android:src="0x7f0e0017"/>
        <Chronometer
            android:textSize="15sp"
            android:textColor="#ffffffff"
            android:id="0x7f080253"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format="00:%s%s:%s%s"/>
    </LinearLayout>
</RelativeLayout>
