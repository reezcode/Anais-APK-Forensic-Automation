<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:background="0x7f050413"
        android:paddingTop="0x7f0603ae"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.Toolbar
            android:id="0x7f0802f2"
            android:background="?unknown_attr_ref: 7f03023b"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp">
        <Button
            android:id="0x7f080094"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Video File"
            android:textAllCaps="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <TextView
            android:textSize="20sp"
            android:textColor="@android:color/black"
            android:gravity="top"
            android:layout_gravity="top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Before: "
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:id="0x7f080335"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="3"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <TextView
            android:textSize="20sp"
            android:textColor="@android:color/black"
            android:gravity="top"
            android:layout_gravity="top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="After: "
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:id="0x7f08033b"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_weight="3"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:id="0x7f080334"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@android:color/black"
        android:id="0x7f080344"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"/>
    <ProgressBar
        android:id="0x7f08023b"
        android:visibility="invisible"
        android:layout_width="40dp"
        android:layout_height="40dp"/>
</LinearLayout>
