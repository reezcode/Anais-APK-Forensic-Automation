<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@drawable/bg_input_words_tronlink"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/nav_rl"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btn_back"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/return_icon"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/sv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/nav_rl">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sv_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="32dp"
                android:layout_marginRight="32dp">
                <TextView
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Import_Wallet"
                    android:layout_weight="7"/>
                <pl.droidsonroids.gif.GifImageView
                    android:gravity="center"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/import_tronlink"/>
            </LinearLayout>
            <EditText
                android:textSize="14sp"
                android:gravity="start|top"
                android:id="@+id/edit_words"
                android:background="@drawable/bg_input_words_tronlink_et"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="56dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="36dp"
                android:layout_marginRight="16dp"
                android:hint="@string/Enter_mnemonic_separated_by_space"
                android:maxLines="6"
                android:minLines="6"
                android:inputType="textMultiLine"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="-34dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:singleLine="true"
                    android:layout_weight="8"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/Grey_900"
                    android:id="@+id/btn_paste"
                    android:paddingRight="28dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/Paste"
                    android:singleLine="true"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tips_ll"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/Red"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tips_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/Incorrect_seed_phrase_check_and_try_again"
                    android:maxLines="2"
                    android:lineHeight="18dp"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_submit"
                android:background="@drawable/bg_tronlink_confirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="60dp"
                android:layout_marginRight="16dp"
                android:text="@string/Continue"
                android:lines="1"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/prompt_ll"
        android:background="@color/Grey_100"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/words_ll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word0"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word1"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word2"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word3"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word4"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word5"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word6"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word7"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word8"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word9"
                    android:background="@drawable/bg_input_words_tronlink_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
