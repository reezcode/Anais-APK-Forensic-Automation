<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/Grey_100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/nav_rl"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btn_back"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/return_icon"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/sv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/nav_rl">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sv_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/Sign_in_with_a_recovery_phrase"
                android:lineHeight="36dp"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/Grey_800"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="20dp"
                android:text="@string/This_is_a_12word_phrase"
                android:lineHeight="18dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/blue_900"
                android:id="@+id/btn_about"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/Where_can_I_find_this"/>
            <EditText
                android:textSize="16sp"
                android:gravity="start|top"
                android:id="@+id/edit_words"
                android:background="@drawable/bg_input_words_wallet_et"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="6dp"
                android:hint="@string/a12word_recovery_phrase"
                android:maxLines="5"
                android:minLines="5"
                android:inputType="textMultiLine"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tips_ll"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/Red"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tips_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/Invalid_recovery_phrase"
                    android:maxLines="2"
                    android:lineHeight="18dp"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_submit"
                android:background="@drawable/bg_wallet_confirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginRight="16dp"
                android:text="@string/Continue"
                android:lines="1"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/prompt_ll"
        android:background="@color/Grey_100"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/words_ll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word0"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word1"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word2"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word3"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word4"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word5"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word6"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word7"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word8"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/Grey_800"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word9"
                    android:background="@drawable/bg_input_words_wallet_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
