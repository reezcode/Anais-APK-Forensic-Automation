    <string name="tpBoxBackupConfirm">এখন ব্যাক আপ</string>
    <string name="tpBoxBackupMsg">প্রোগ্রামে কোনো বাগ দেখা দিলে, অনুগ্রহ করে সময়মতো স্মৃতিকথার ব্যাক আপ নিন যাতে এটি হারানো না হয়!\n \n হোম পেজ -&gt; বিশদ -&gt; �� -&gt; গোপন পুনরুদ্ধার বাক্য নির্যাতন\n \n মনে রাখবেন:\n ・ কাউকেই গোপন পুনরুদ্ধার বাক্যটি ফাঁসান না করুন\n ・ গোপন পুনরুদ্ধার বাক্য হারিয়ে গেলে সম্পদ পুনরুদ্ধার করা যাবে না\n ・ স্ক্রিনশট বা নেটওয়ার্ক প্রেরণের মাধ্যমে ব্যাকআপ করবেন না\n ・ সমস্যা সম্পর্কে যখনই আছে, অ্যাপটি বিনামূল্যে অপসারণ করবেন না, অনুগ্রহ করে সাহায্যের জন্য আমাদেরকে যোগাযোগ করুন</string>
    <string name="tpBoxBackupTitle">গুরুত্বপূর্ণ অনুস্মারক</string>
