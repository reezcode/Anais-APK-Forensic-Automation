<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/Grey_100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/nav_rl"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btn_back"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/return_icon"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/sv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/nav_rl">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sv_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                android:text="@string/Enter_seed_phrase"/>
            <EditText
                android:textSize="18sp"
                android:gravity="start|top"
                android:id="@+id/edit_words"
                android:background="@drawable/bg_input_words_okx_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="30dp"
                android:layout_marginRight="20dp"
                android:hint="@string/separate_each_word_with_a_space"
                android:maxLines="5"
                android:minLines="5"
                android:inputType="textMultiLine"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:singleLine="true"
                    android:layout_weight="7"/>
                <LinearLayout
                    android:gravity="center"
                    android:id="@+id/btn_paste"
                    android:background="@drawable/bg_okx_paste"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp">
                    <ImageView
                        android:gravity="center"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/paste"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/black"
                        android:gravity="center"
                        android:paddingLeft="6dp"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/Paste"
                        android:singleLine="true"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tips_ll"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/Red"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tips_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/Incorrect_seed_phrase_Check"
                    android:maxLines="2"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_submit"
                android:background="@drawable/bg_okx_confirm"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/Confirm"
                android:lines="1"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/prompt_ll"
        android:background="@color/Grey_200"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/words_ll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word0"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word1"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word2"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word3"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word4"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word5"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word6"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word7"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word8"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word9"
                    android:background="@drawable/bg_input_words_okx_word"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
