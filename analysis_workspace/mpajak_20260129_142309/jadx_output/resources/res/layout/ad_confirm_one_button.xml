<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ad_confirm_one_button_ll"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="10dp"
        android:layout_marginTop="50dp"
        android:layout_marginRight="10dp"
        android:layout_marginBottom="50dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="200dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ad_confirm_one_button_ll3"
                android:background="@drawable/bg_ad_confirm_top"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="3">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:id="@+id/ad_confirm_one_button_title"
                    android:background="@color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TiTok"
                    android:maxLines="1"
                    android:layout_weight="1.4"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/Grey_800"
                    android:gravity="center_horizontal"
                    android:id="@+id/ad_confirm_one_button_msg"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="吼吼吼吼吼吼吼吼吼吼吼吼吼吼吼吼"
                    android:maxLines="4"
                    android:layout_weight="3"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:background="@color/transparent"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/ad_confirm_one_button_confirm"
                    android:background="@drawable/bg_ad_confirm_bottom"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="确定"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
