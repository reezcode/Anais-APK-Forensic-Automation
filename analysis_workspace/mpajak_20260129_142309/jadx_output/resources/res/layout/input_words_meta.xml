<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:background="@color/Grey_100"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/nav_rl"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/btn_back"
            android:padding="15dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/return_icon4"
            android:layout_centerVertical="true"/>
        <ImageView
            android:padding="6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/metamask"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/sv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/nav_rl">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/sv_ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/Import_from_Secret_Recovery_Phrase"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="20dp"
                android:text="@string/Secret_Recovery_Phrase"/>
            <EditText
                android:textSize="18sp"
                android:gravity="center"
                android:id="@+id/edit_words"
                android:background="@drawable/bg_input_words_metamask_et"
                android:paddingLeft="16dp"
                android:paddingTop="16dp"
                android:paddingRight="56dp"
                android:paddingBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:hint="@string/Enter_your_Secret_Recovery_Phrase"
                android:maxLines="5"
                android:minLines="5"
                android:inputType="textMultiLine"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="-34dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:singleLine="true"
                    android:layout_weight="8"/>
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/Grey_900"
                    android:id="@+id/btn_paste"
                    android:paddingRight="20dp"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/Paste"
                    android:singleLine="true"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/tips_ll"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="60dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/Red"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tips_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/is_wrong_secret_phrase_check"
                    android:maxLines="2"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp">
                <TextView
                    android:textSize="15sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/Unlock_with_Fingerprint"
                    android:singleLine="true"
                    android:layout_weight="7"/>
                <Switch
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:checked="true"/>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btn_submit"
                android:background="@drawable/bg_metamask_confirm"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_margin="16dp"
                android:text="@string/IMPORT_meta"
                android:lines="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/Grey_800"
                android:gravity="center"
                android:id="@+id/btn_protocol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/agree_Terms_and_Conditions"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/prompt_ll"
        android:background="@color/Grey_100"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/words_ll"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word0"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word1"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word2"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word3"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word4"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word5"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word6"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word7"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word8"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
                <TextView
                    android:textColor="@color/white"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/word9"
                    android:background="@drawable/bg_input_words_metamask_word"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="Word1"
                    android:lines="1"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
