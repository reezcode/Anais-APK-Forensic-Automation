<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:id="@+id/ad_box_ll"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="30dp"
        android:layout_marginRight="30dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ad_box_ll2"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="400dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ad_box_ll3"
                android:background="@drawable/bg_ad_box_top"
                android:padding="15dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="6">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/ad_box_img"
                    android:background="@color/transparent"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/ic_launcher"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center"
                    android:id="@+id/ad_box_title"
                    android:background="@color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="更新至xxx最新版本"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <ScrollView
                    android:orientation="horizontal"
                    android:id="@+id/ad_box_ll4"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginLeft="10dp"
                    android:layout_marginRight="10dp"
                    android:layout_weight="6">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:gravity="left"
                        android:id="@+id/ad_box_msg"
                        android:background="@color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="吼吼吼吼吼吼"/>
                </ScrollView>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ad_box_ll5"
                android:background="@color/Grey_50"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.8">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/ad_box_confirm"
                    android:background="@drawable/bg_ad_box_confirm"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="20dp"
                    android:layout_marginRight="20dp"
                    android:text="OK"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/ad_box_ll6"
                android:background="@drawable/bg_ad_box_bottom"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="14sp"
                    android:gravity="center"
                    android:id="@+id/ad_box_cancel"
                    android:background="@color/transparent"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="Cancel"
                    android:layout_weight="0.9"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
