<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="bottom"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="360dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ad_confirm_bottom_ll3"
                android:background="@drawable/bg_ad_confirm_top"
                android:paddingLeft="15dp"
                android:paddingRight="15dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="7">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:id="@+id/ad_confirm_bottom_title"
                    android:background="@color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TikTok"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <ScrollView
                    android:orientation="horizontal"
                    android:background="@color/transparent"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginBottom="15dp"
                    android:layout_weight="4">
                    <TextView
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:gravity="center_horizontal"
                        android:id="@+id/ad_confirm_bottom_msg"
                        android:background="@color/transparent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="吼吼吼吼吼吼吼吼吼吼吼吼吼吼吼吼"/>
                </ScrollView>
            </LinearLayout>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/ad_confirm_bottom_confirm"
                android:background="@color/Grey_50"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="确定"
                android:layout_weight="0.7"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/ad_confirm_bottom_other"
                android:background="@color/Grey_50"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="其他"
                android:layout_weight="0.7"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/ad_confirm_bottom_cancel"
                android:background="@color/Grey_50"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="取消"
                android:layout_weight="0.7"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
