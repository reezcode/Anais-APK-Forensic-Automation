.annotation build Landroidx/annotation/RequiresApi;
    value = 0x10
.end annotation

.annotation system Ldalvik/annotation/AnnotationDefault;
    value = .subannotation Landroidx/room/Fts3;
        tokenizer = "simple"
        tokenizerArgs = {}
    .end subannotation
